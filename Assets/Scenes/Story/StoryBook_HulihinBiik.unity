  m_Script: {fileID: 11500000, guid: 682d62521bfde15479ee7dea7b6741cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryBookManager
  pages:
  - page: {fileID: 147228140}
    dialogues:
    - speaker: Lolo
      dialogue: Liam, may ibibigay ako sayo na matutuwa ka. Alam ko na mahilig ka
        sa mga laro at ikakasaya mo ito.
  - page: {fileID: 1574174022}
    dialogues:
    - speaker: Liam
      dialogue: Totoo lolo may ibibigay ka sakin? ano yon lolo?!
  - page: {fileID: 441064545}
    dialogues:
    - speaker: Lolo
      dialogue: Halika at sumunod ka sakin liam.
  - page: {fileID: 1112643785}
    dialogues:
    - speaker: Liam
      dialogue: San tayo poponta lolo? excited nako makita ang supresa mo sakin lolo.
  - page: {fileID: 1206587787}
    dialogues:
    - speaker: Narrator
      dialogue: PUMASOK SA STORAGE ROOM
    - speaker: Narrator
      dialogue: ' NAKITA ANG BAUL'
    - speaker: Narrator
      dialogue: ' HINAWAKAN NI LIAM ANG BAUL'
    - speaker: Narrator
      dialogue: ' BINUKSAN ANG BAUL'
  - page: {fileID: 394312430}
    dialogues:
    - speaker: Narrator
      dialogue: ' LUMITAW ANG LIBRO'
    - speaker: LIam
      dialogue: "\u201CA talking book?!\u201D"
    - speaker: Lolo
      dialogue: 'sino na ka at ano ka '
    - speaker: StoryBook
      dialogue: "\u201CWelcome, Liam.\u201D"
  - page: {fileID: 1565178857}
    dialogues:
    - speaker: Narrator
      dialogue: ' NAPUNTA ANG MAG LOLO SA NAKARAAN'
    - speaker: LIam
      dialogue: "\u201CWhere are we?\u201D"
    - speaker: Lolo
      dialogue: "\u201CThis isn't our time\u2026\u201D"
    - speaker: StoryBook
      dialogue: "\u201CYou have traveled to the past.\u201D\r\n"
  - page: {fileID: 1754870909}
    dialogues:
    - speaker: Narrator
      dialogue: ' IPINALIWANAG NG LIBRO'
    - speaker: StoryBook
      dialogue: " \u201CHere, you will discover the games of the past.\u201D"
    - speaker: Liam
      dialogue: " \u201CGames?\u201D"
    - speaker: StoryBook
      dialogue: "\u201CFilipino street games.\u201D"
  - page: {fileID: 311216747}
    dialogues:
    - speaker: Narrator
      dialogue: ' IPINALIWANAG NG LIBRO'
    - speaker: Lolo
      dialogue: Maari mo ba kaming Ibalik sa lugar at oras namin
    - speaker: StorBook
      dialogue: Ibabalik ko kayo kung mananalo si liam sa mga larong ipapalaro ko
        sa kanya
  - page: {fileID: 413301675}
    dialogues:
    - speaker: LIam
      dialogue: Ano po ba ang mga laro na ipapalaro nyo po
    - speaker: StoryBook
      dialogue: 'May apat na klase ang mga laro na ipapalaro ko sayo '
    - speaker: StoryBook
      dialogue: Unang laro Hulihin ang baboy..
    - speaker: StoryBook
      dialogue: 'Matututo kang dumiskarte sa paghuli ng baboy habang napapabilis
        at napapaliksi ang iyong galaw.

'
    - speaker: LIam
      dialogue: 'Matututo kang dumiskarte sa paghuli ng baboy habang napapabilis
        at napapaliksi ang iyong galaw.

'
    - speaker: StoryBook
      dialogue: 'Matututo kang dumiskarte sa paghuli ng baboy habang napapabilis
        at napapaliksi ang iyong galaw.

'
  dialoguePanel: {fileID: 1186768157}
  speakerNameText: {fileID: 2075015883}
  dialogueText: {fileID: 989744675}
