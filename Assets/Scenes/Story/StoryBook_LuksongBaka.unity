  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryBookManager
  pages:
  - page: {fileID: 167650339}
    dialogues:
    - speaker: StoryBook
      dialogue: Ang galing mo Liam natapos mo ng mahusay ang taltong laro.
    - speaker: StoryBook
      dialogue: At para sa huling laro....
    - speaker: StoryBook
      dialogue: Luksong Baka
  - page: {fileID: 99641718}
    dialogues:
    - speaker: Liam
      dialogue: Luksong Baka?
  - page: {fileID: 670589053}
    dialogues:
    - speaker: StoryBook
      dialogue: 'Ang LuksongBaka isang tradisyonal na laro ng mga pilipino

        na
        kung saan tumatalon'
    - speaker: StoryBook
      dialogue: ang isang manlalaro sa ibabaw ng nakayukong kalaro
    - speaker: StoryBook
      dialogue: Layunin nito makatalon ng hindi tumatama o natutumba ang taya.
  - page: {fileID: 1639407060}
    dialogues:
    - speaker: Lolo
      dialogue: Sa wakas apo huling laro na ito makakuwi na tayo
  - page: {fileID: 2004840356}
    dialogues:
    - speaker: StoryBook
      dialogue: Sumalan na ang huling laro
  dialoguePanel: {fileID: 131383251}
