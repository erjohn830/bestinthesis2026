  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 682d62521bfde15479ee7dea7b6741cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryBookManager
  pages:
  - page: {fileID: 1620081750}
    dialogues:
    - speaker: StoryBook
      dialogue: Magaling liam... nanalo ka sa unang laro
    - speaker: StoryBook
      dialogue: Alam mo ba..
    - speaker: StoryBook
      dialogue: Ang Hulihin ang Baboy ay isang tradisyunal na larong Pilipino na
        karaniwang ginagawa tuwing pista at mga pagdiriwang.
    - speaker: StoryBook
      dialogue: Matagal na itong bahagi ng kulturang Pilipino. Layunin nitong magbigay
        saya habang nahahasa ang bilis, liksi, koordinasyon, at diskarte ng mga manlalaro.
  - page: {fileID: 608109587}
    dialogues:
    - speaker: Lolo
      dialogue: Ang galing mo apo
    - speaker: Lolo
      dialogue: "\u201CAlam mo ba, apo? Noong panahon namin, isa ang larong iyan
        sa mga paborito naming libangan. lalo na sa mga Fiesta\u201D"
  - page: {fileID: 9474840}
    dialogues:
    - speaker: Lolo
      dialogue: "\u201CMaraming salamat, StoryBook! Masaya ako dahil naranasan din
        ng apo ko ang larong nilalaro namin noon.\u201D"
    - speaker: StoryBook
      dialogue: Walang anuman po Lolo
    - speaker: StoryBook
      dialogue: "\u201CO, Liam! Handa ka na ba sa susunod na laro?\u201D"
  - page: {fileID: 676338570}
    dialogues:
    - speaker: Liam
      dialogue: '"Handa na po ako"'
  - page: {fileID: 32949943}
    dialogues:
    - speaker: StoryBook
      dialogue: '"Ang susunod na laro ay Sipa"'
  - page: {fileID: 2041291797}
    dialogues:
    - speaker: Liam
      dialogue: '"Sipa?"'
    - speaker: Liam
      dialogue: '"Anong klaseng laro po iyon"'
  - page: {fileID: 268901869}
    dialogues:
    - speaker: StoryBook
      dialogue: '"Ang Sipa ay isang Tradisyonal na larong pilipino "'
    - speaker: StoryBook
      dialogue: '"Matagal na nilalaro ito bago pa dumating ang mga kastila "'
    - speaker: StoryBook
      dialogue: '"Layunin nito panatiliin ang sipa pato sa ere"'
    - speaker: StoryBook
      dialogue: '"Handa ka na ba laruin to? liam?"'
  - page: {fileID: 1675188945}
    dialogues:
    - speaker: Liam
      dialogue: '"Opo. Handa na ako!"'
  dialoguePanel: {fileID: 1078329880}
  speakerNameText: {fileID: 2028102566}
  dialogueText: {fileID: 2001566047}
  typingSpeed: 0.04
  topBlackPanel: {fileID: 726836984}
  bottomBlackPanel: {fileID: 935966034}
  blackPanelMoveDistance: 500
