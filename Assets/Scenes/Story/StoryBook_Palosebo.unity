  m_Script: {fileID: 11500000, guid: 682d62521bfde15479ee7dea7b6741cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryBookManager
  pages:
  - page: {fileID: 707324604}
    dialogues:
    - speaker: StoryBook
      dialogue: Mahusay liam
    - speaker: StoryBook
      dialogue: Alam mo ba?
    - speaker: StoryBook
      dialogue: Ang sipa ay isang tradisyunal na laro ng mga pilipino na nilalaro
        gamit ang maliit na laruan.
    - speaker: StoryBook
      dialogue: 'Na sinisipa at pinanantiling nasa ere ito. '
    - speaker: StoryBook
      dialogue: 'Mahalaga ang pag balanse at kontrol ng iyong pag sipa dito '
    - speaker: StoryBook
      dialogue: 'Ang susunod na laro na ipapalaro ko sayo ay Palosebo '
  - page: {fileID: 268982467}
    dialogues:
    - speaker: Liam
      dialogue: Palosebo?
  - page: {fileID: 1074354519}
    dialogues:
    - speaker: StoryBook
      dialogue: 'Ang palosebo ay isa rin tradisyonal na laro '
    - speaker: StoryBook
      dialogue: Na kinakailangan umakyat ng manlalaro sa isang mataas at madulas
        na poste o kawayan
  - page: {fileID: 282641248}
    dialogues:
    - speaker: Lolo
      dialogue: Basta mag ingat ka Apo
    - speaker: Lolo
      dialogue: Basta ang kailangan mo lang Diskarte at Tyaga sa pagakyat dito
  dialoguePanel: {fileID: 574874589}
  speakerNameText: {fileID: 1589762447}
  dialogueText: {fileID: 788519994}
  typingSpeed: 0.04
  topBlackPanel: {fileID: 155566525}
  bottomBlackPanel: {fileID: 528499621}
  blackPanelMoveDistance: 500
  blackPanelMoveDuration: 1.5
